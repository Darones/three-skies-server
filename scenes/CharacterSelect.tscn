[sub_resource type="Shader" id="Shader_nb21n"]
code = "shader_type canvas_item;
uniform float corner_radius_px = 18.0;
void fragment() {
	vec2 texture_size = 1.0 / TEXTURE_PIXEL_SIZE;
	vec2 point = UV * texture_size;
	vec2 half_size = texture_size * 0.5;
	vec2 d = abs(point - half_size) - (half_size - vec2(corner_radius_px));
	float edge = length(max(d, vec2(0.0))) + min(max(d.x, d.y), 0.0) - corner_radius_px;
	if (edge > 0.0) { discard; }
	COLOR = texture(TEXTURE, UV) * COLOR;
}"

