[sub_resource type="Shader" id="Shader_c01mt"]
code = "shader_type canvas_item;
uniform float inner_radius = 0.48;
uniform float outer_radius = 1.28;
uniform float max_alpha = 0.68;
void fragment() {
	vec2 centered = (UV - vec2(0.5)) * 2.0;
	float radius = length(centered);
	float darkness = smoothstep(inner_radius, outer_radius, radius) * max_alpha;
	COLOR = vec4(vec3(0.0), darkness);
}"

